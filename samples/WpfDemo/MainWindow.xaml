<Window x:Class="WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDemo"
        xmlns:lucide="http://lucide.net/wpf"
        mc:Ignorable="d"
        Title="Lucide.NET WPF Demo" Height="720" Width="980">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF1D4ED8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF64748B" />
    </Window.Resources>

    <Window.Background>
        <StaticResource ResourceKey="BackgroundBrush" />
    </Window.Background>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}" Padding="20" CornerRadius="12" BorderBrush="#FFE2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Lucide.NET" FontSize="26" FontWeight="SemiBold" Foreground="#FF0F172A" />
                <TextBlock Text="Fast, cached Lucide icons for WPF" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Icons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" Margin="6" Padding="12" CornerRadius="10" BorderBrush="#FFE2E8F0" BorderThickness="1">
                            <StackPanel Width="120" HorizontalAlignment="Center">
                                <lucide:LucideIcon Kind="{Binding}" Width="32" Height="32" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
