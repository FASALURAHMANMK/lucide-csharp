<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net48;net6.0-windows;net8.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="$(_SdkMajor) &gt;= 10">$(TargetFrameworks);net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lucide.NET.Wpf</AssemblyName>
    <RootNamespace>Lucide.NET.Wpf</RootNamespace>
    <PackageId>Lucide.NET.Wpf</PackageId>
    <Description>WPF controls and helpers for Lucide icons.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucide.NET.Core\Lucide.NET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>
</Project>
