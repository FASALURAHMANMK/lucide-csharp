<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <AssemblyName>Lucide.NET.Core</AssemblyName>
    <RootNamespace>Lucide.NET</RootNamespace>
    <PackageId>Lucide.NET.Core</PackageId>
    <Description>Core Lucide icon catalog and SVG retrieval APIs.</Description>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Resources\\lucide_icons.bin')">
    <EmbeddedResource Include="Resources\\lucide_icons.bin" />
  </ItemGroup>
</Project>
